#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

note() { printf 'herdr-message: %s\n' "$*" >&2; }
die()  { printf 'herdr-message: ERROR: %s\n' "$*" >&2; exit 1; }
guard() { [ "${HERDR_ENV:-}" = 1 ]; }

# 6-character lowercase alphanumeric id -- collision risk is irrelevant here: it's an informal,
# human/agent-legible correlation tag for an async conversation, not a security token or a
# globally unique identifier. No external uuid/hash dependency needed.
generate_message_id() {
  local chars="abcdefghijklmnopqrstuvwxyz0123456789" id="" i
  for i in $(seq 1 6); do id+="${chars:$((RANDOM % ${#chars})):1}"; done
  printf '%s' "$id"
}

# Resolves the CALLING agent's own identity for an envelope's "from" line. The pane id is
# always $HERDR_PANE_ID (guard() already confirmed we're in herdr, and callers additionally
# require it non-empty before calling this) -- it is the ONLY guaranteed-resolvable reply
# target, since an unnamed agent has no resolvable name yet, only a pane id (same reasoning
# already established in rotate's own send_handoff: "the pane id always does, whether or not
# the agent is named"). The name is included ONLY when one currently exists, purely for
# readability -- never required, and an `agent get` failure is treated the same as "no name
# set" rather than aborting the send over a cosmetic lookup.
sender_from_line() {
  local name
  name=$(herdr agent get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.agent.name // empty') || name=""
  if [ -n "$name" ]; then printf '%s@%s' "$name" "$HERDR_PANE_ID"
  else printf '%s' "$HERDR_PANE_ID"; fi
}

# The "--- callback requested ---" block appended to a send/reply envelope when a reply is
# requested (empty otherwise). Shared by build_send_envelope and build_reply_envelope so the two
# subcommands offer IDENTICAL callback behavior. $1=callback(0/1) $2=callback_msg $3=id -- the
# correlation id the recipient should reply under: a send's own freshly generated id, or, for a
# reply, the SAME id being replied to (so a multi-round exchange keeps threading under one id).
callback_suffix() {
  local callback="$1" callback_msg="$2" id="$3"
  [ "$callback" = 1 ] || return 0
  local instr
  if [ -n "$callback_msg" ]; then instr="$callback_msg"
  # Points at this script's OWN `reply` subcommand rather than telling the recipient to
  # hand-construct a raw `herdr agent prompt` envelope -- avoids a mistyped [reply:...] tag
  # breaking the correlation the sender is relying on. Every dynamic token is %q-quoted: a
  # `reply` threads under a CALLER-SUPPLIED, UNVALIDATED id (send's own ids are always clean
  # 6-char alnum, but reply carries whatever id it was given -- possibly with quotes, spaces,
  # or shell metacharacters), so an unquoted interpolation here would emit a command the
  # recipient cannot run and still recover the exact id. %q is a no-op for the clean case, so
  # send's emitted command is unchanged.
  else
    local q_path q_pane q_id
    printf -v q_path '%q' "$HERE/herdr-message"
    printf -v q_pane '%q' "$HERDR_PANE_ID"
    printf -v q_id   '%q' "$id"
    instr="When convenient, reply with: $q_path reply $q_pane $q_id \"<your update>\""
  fi
  printf '\n\n--- callback requested ---\n%s' "$instr"
}

# $1=id $2=from $3=text $4=callback(0/1) $5=callback_msg (only used when $4=1)
build_send_envelope() {
  local id="$1" from="$2" text="$3" callback="$4" callback_msg="$5"
  printf '[msg-%s from %s]\n%s%s' "$id" "$from" "$text" "$(callback_suffix "$callback" "$callback_msg" "$id")"
}

# Same shape and args as build_send_envelope -- only the tag differs: [reply:<id>] threads the
# answer back to a specific prior message. The callback block, if any, is byte-identical to send's.
# $1=id $2=from $3=text $4=callback(0/1) $5=callback_msg (only used when $4=1)
build_reply_envelope() {
  local id="$1" from="$2" text="$3" callback="$4" callback_msg="$5"
  printf '[reply:%s from %s]\n%s%s' "$id" "$from" "$text" "$(callback_suffix "$callback" "$callback_msg" "$id")"
}

# Prints the send/reply result JSON via jq, not raw printf -- $id (always caller-supplied for
# reply, never validated) and $target (always caller-supplied) could otherwise produce invalid
# JSON if they contain a literal quote or backslash. $1=id $2=target
print_result() {
  jq -nc --arg id "$1" --arg target "$2" '{"message_id":$id,"sent_to":$target}'
}

# Parses the trailing [--callback [MSG]] / --callback=MSG flags shared by send and reply, into
# the two named variables (flag + custom message) via nameref. Both subcommands take their fixed
# positionals first, then hand whatever remains here. $1=callback-var-name $2=msg-var-name, then
# the remaining argv.
parse_callback_flags() {
  local -n _cb="$1" _msg="$2"; shift 2
  _cb=0; _msg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      # Unambiguous attached form: everything after "=" on this SAME token is the literal custom
      # message, no matter what it starts with -- same convention this repo already uses elsewhere
      # (strip_context_flags's --session-id=zzz, rotate-common.sh's --config=key=value).
      --callback=*) _cb=1; _msg="${1#--callback=}"; shift ;;
      --callback)
        _cb=1
        # Optional-value flag: consume the next token as custom text ONLY if it doesn't look like
        # another flag -- same peek-ahead technique already used in this codebase for claude's own
        # -r/--resume [value] (see rotate-common.sh's strip_context_flags). A custom message that
        # itself starts with "-" can never be represented this way -- use --callback=<msg> instead,
        # which takes it literally.
        if [ $# -ge 2 ] && [[ "$2" != -* ]]; then _msg="$2"; shift 2
        else shift; fi
        ;;
      *) die "unknown option: $1" ;;
    esac
  done
}

cmd_send() {
  guard || { note "not in herdr (HERDR_ENV != 1); no-op"; exit 0; }
  [ -n "${HERDR_PANE_ID:-}" ] || die "HERDR_PANE_ID is not set -- cannot determine sender identity"
  # <target> and <text> are fixed-shape REQUIRED positionals, always first, in this order --
  # taken by position, with NO flag-sniffing. The caller here is typically an LLM writing
  # free-form message text, not a careful shell user who knows to prepend "--"; sniffing every
  # token for a leading "-" would misread an ordinary message that happens to start with one
  # (a bullet point, "-1", an em-dash opener, ...) as an unrecognized option.
  [ $# -ge 2 ] || die "usage: herdr-message send <target> <text> [--callback [MSG]]"
  local target="$1" text="$2"; shift 2
  local callback callback_msg
  parse_callback_flags callback callback_msg "$@"
  local id from envelope err
  id=$(generate_message_id)
  from=$(sender_from_line)
  envelope=$(build_send_envelope "$id" "$from" "$text" "$callback" "$callback_msg")
  err=$(herdr agent prompt "$target" "$envelope" 2>&1 >/dev/null) || die "failed to send message to $target${err:+: $err}"
  print_result "$id" "$target"
}

cmd_reply() {
  guard || { note "not in herdr (HERDR_ENV != 1); no-op"; exit 0; }
  [ -n "${HERDR_PANE_ID:-}" ] || die "HERDR_PANE_ID is not set -- cannot determine sender identity"
  # <target> <message-id> <text> are fixed-shape REQUIRED positionals, in this order, taken by
  # position with NO flag-sniffing (same reasoning as send: <text> is free-form and may start with
  # "-"). Any trailing tokens are the optional [--callback [MSG]] flags -- so a threaded reply can
  # ALSO request a further response, exactly like send.
  [ $# -ge 3 ] || die "usage: herdr-message reply <target> <message-id> <text> [--callback [MSG]]"
  local target="$1" id="$2" text="$3"; shift 3
  local callback callback_msg
  parse_callback_flags callback callback_msg "$@"
  local from envelope err
  from=$(sender_from_line)
  envelope=$(build_reply_envelope "$id" "$from" "$text" "$callback" "$callback_msg")
  err=$(herdr agent prompt "$target" "$envelope" 2>&1 >/dev/null) || die "failed to send reply to $target${err:+: $err}"
  print_result "$id" "$target"
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  sub="${1:-}"; shift || true
  case "$sub" in
    send)  cmd_send "$@" ;;
    reply) cmd_reply "$@" ;;
    *) die "usage: herdr-message <send|reply> ..." ;;
  esac
fi
