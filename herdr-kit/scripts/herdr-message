#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

note() { printf 'herdr-message: %s\n' "$*" >&2; }
die()  { printf 'herdr-message: ERROR: %s\n' "$*" >&2; exit 1; }
guard() { [ "${HERDR_ENV:-}" = 1 ]; }

# 6-character lowercase alphanumeric id -- collision risk is irrelevant here: it's an informal,
# human/agent-legible correlation tag for an async conversation, not a security token or a
# globally unique identifier. No external uuid/hash dependency needed.
generate_message_id() {
  local chars="abcdefghijklmnopqrstuvwxyz0123456789" id="" i
  for i in $(seq 1 6); do id+="${chars:$((RANDOM % ${#chars})):1}"; done
  printf '%s' "$id"
}

# Resolves the CALLING agent's own identity for an envelope's "from" line. The pane id is
# always $HERDR_PANE_ID (guard() already confirmed we're in herdr, and callers additionally
# require it non-empty before calling this) -- it is the ONLY guaranteed-resolvable reply
# target, since an unnamed agent has no resolvable name yet, only a pane id (same reasoning
# already established in rotate's own send_handoff: "the pane id always does, whether or not
# the agent is named"). The name is included ONLY when one currently exists, purely for
# readability -- never required, and an `agent get` failure is treated the same as "no name
# set" rather than aborting the send over a cosmetic lookup.
sender_from_line() {
  local name
  name=$(herdr agent get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.agent.name // empty') || name=""
  if [ -n "$name" ]; then printf '%s@%s' "$name" "$HERDR_PANE_ID"
  else printf '%s' "$HERDR_PANE_ID"; fi
}

# The "--- callback requested ---" block appended to a send/reply envelope when a reply is
# requested (empty otherwise). Shared by build_send_envelope and build_reply_envelope so the two
# subcommands offer IDENTICAL callback behavior. $1=callback(0/1) $2=callback_msg $3=id -- the
# correlation id the recipient should reply under: a send's own freshly generated id, or, for a
# reply, the SAME id being replied to (so a multi-round exchange keeps threading under one id).
callback_suffix() {
  local callback="$1" callback_msg="$2" id="$3"
  [ "$callback" = 1 ] || return 0
  local instr
  if [ -n "$callback_msg" ]; then instr="$callback_msg"
  # Points at this script's OWN `reply` subcommand rather than telling the recipient to
  # hand-construct a raw `herdr agent prompt` envelope -- avoids a mistyped [reply:...] tag
  # breaking the correlation the sender is relying on. Every dynamic token is %q-quoted: a
  # `reply` threads under a CALLER-SUPPLIED, UNVALIDATED id (send's own ids are always clean
  # 6-char alnum, but reply carries whatever id it was given -- possibly with quotes, spaces,
  # or shell metacharacters), so an unquoted interpolation here would emit a command the
  # recipient cannot run and still recover the exact id. %q is a no-op for the clean case, so
  # send's emitted command is unchanged.
  else
    local q_path q_pane q_id
    printf -v q_path '%q' "$HERE/herdr-message"
    printf -v q_pane '%q' "$HERDR_PANE_ID"
    printf -v q_id   '%q' "$id"
    instr="When convenient, reply with: $q_path reply $q_pane $q_id \"<your update>\""
  fi
  printf '\n\n--- callback requested ---\n%s' "$instr"
}

# $1=id $2=from $3=text $4=callback(0/1) $5=callback_msg (only used when $4=1)
build_send_envelope() {
  local id="$1" from="$2" text="$3" callback="$4" callback_msg="$5"
  printf '[msg-%s from %s]\n%s%s' "$id" "$from" "$text" "$(callback_suffix "$callback" "$callback_msg" "$id")"
}

# Same shape and args as build_send_envelope -- only the tag differs: [reply:<id>] threads the
# answer back to a specific prior message. The callback block, if any, is byte-identical to send's.
# $1=id $2=from $3=text $4=callback(0/1) $5=callback_msg (only used when $4=1)
build_reply_envelope() {
  local id="$1" from="$2" text="$3" callback="$4" callback_msg="$5"
  printf '[reply:%s from %s]\n%s%s' "$id" "$from" "$text" "$(callback_suffix "$callback" "$callback_msg" "$id")"
}

# Prints the send/reply result JSON via jq, not raw printf -- $id (always caller-supplied for
# reply, never validated) and $target (always caller-supplied) could otherwise produce invalid
# JSON if they contain a literal quote or backslash. $1=id $2=target
print_result() {
  jq -nc --arg id "$1" --arg target "$2" '{"message_id":$id,"sent_to":$target}'
}

# Parses the trailing [--callback [MSG]] / --callback=MSG flags shared by send and reply, into
# the two named variables (flag + custom message) via nameref. Both subcommands take their fixed
# positionals first, then hand whatever remains here. $1=callback-var-name $2=msg-var-name, then
# the remaining argv.
parse_callback_flags() {
  local -n _cb="$1" _msg="$2"; shift 2
  _cb=0; _msg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      # Unambiguous attached form: everything after "=" on this SAME token is the literal custom
      # message, no matter what it starts with -- same convention this repo already uses elsewhere
      # (strip_context_flags's --session-id=zzz, rotate-common.sh's --config=key=value).
      --callback=*) _cb=1; _msg="${1#--callback=}"; shift ;;
      --callback)
        _cb=1
        # Optional-value flag: consume the next token as custom text ONLY if it doesn't look like
        # another flag -- same peek-ahead technique already used in this codebase for claude's own
        # -r/--resume [value] (see rotate-common.sh's strip_context_flags). A custom message that
        # itself starts with "-" can never be represented this way -- use --callback=<msg> instead,
        # which takes it literally.
        if [ $# -ge 2 ] && [[ "$2" != -* ]]; then _msg="$2"; shift 2
        else shift; fi
        ;;
      *) die "unknown option: $1" ;;
    esac
  done
}

# Prefixes every screen line (ANSI escapes allowed) with a one-letter tag: "R" when the line, with its
# escapes removed, starts with a rule ("──"), otherwise "T". The rest of the line is its text with:
#  - every escape sequence removed (SGR in ";" or ":" form, any other CSI such as ESC[K, OSC and the
#    DCS/SOS/PM/APC string controls up to their terminator (an unterminated one drops the rest of the
#    line), charset designators such as ESC ( B and ESC * B, two-byte escapes such as ESC 7 and ESC 8,
#    a dangling ESC);
#  - dim (SGR 2) text dropped, so a placeholder hint never counts as typed text;
#  - reverse-video (SGR 7) text kept, EXCEPT one cell that is directly followed by dim text AND has
#    nothing typed before it on the line (only the prompt marker and spaces): that is the cursor sitting
#    on the first letter of a dim hint (claude draws "Press up to edit queued messages" that way). A
#    cursor over typed text with text before it, or selected text, stays; a blank cursor cell is only
#    whitespace and is ignored later. Neither claude nor pi draws dim text after typed input today.
# SGR state (dim, reverse) carries across lines as in a real ANSI stream; the pending reverse text does
# not. No-break spaces become plain spaces. A plain screen without escapes passes through unchanged.
_screen_filter() {
  LC_ALL=C awk '
    BEGIN { dim = 0; rev = 0 }
    {
      line = $0
      gsub(/\r/, "", line)
      gsub(/\302\240/, " ", line)
      plain = ""; out = ""; pend = ""
      while (length(line) > 0) {
        if (substr(line, 1, 1) == "\033") {
          if (match(line, "^\033\\[[0-?]*[ -/]*[@-~]")) {
            if (substr(line, RLENGTH, 1) == "m") {
              seq = substr(line, 3, RLENGTH - 3)
              n = split(seq, a, ";")
              if (seq == "") { dim = 0; rev = 0 }
              for (i = 1; i <= n; i++) {
                split(a[i], p, ":"); c = p[1] + 0
                if (c == 38 || c == 48 || c == 58) {
                  if (index(a[i], ":") == 0) { if (a[i+1] + 0 == 2) i += 4; else if (a[i+1] + 0 == 5) i += 2 }
                  continue
                }
                if (c == 0) { dim = 0; rev = 0 } else if (c == 2) dim = 1; else if (c == 22) dim = 0; else if (c == 7) rev = 1; else if (c == 27) rev = 0
              }
            }
            line = substr(line, RLENGTH + 1)
          } else if (match(line, "^\033[]PX^_][^\033\007]*(\007|\033\\\\)")) {
            line = substr(line, RLENGTH + 1)
          } else if (match(line, "^\033[]PX^_]")) {
            line = ""
          } else if (match(line, "^\033[ -/]+[0-~]")) {
            line = substr(line, RLENGTH + 1)
          } else if (match(line, "^\033[0-~]")) {
            line = substr(line, RLENGTH + 1)
          } else {
            line = substr(line, 2)
          }
          continue
        }
        ch = substr(line, 1, 1); line = substr(line, 2)
        plain = plain ch
        if (dim) {
          if (pend != "") {
            tmp = out; gsub(/\342\235\257/, "", tmp); gsub(/[ \t]/, "", tmp)
            if (tmp == "" && length(pend) <= 4) pend = ""
            else { out = out pend; pend = "" }
          }
        }
        else if (rev) pend = pend ch
        else { out = out pend ch; pend = "" }
      }
      out = out pend
      print ((substr(plain, 1, 6) == "──") ? "R" : "T") out
    }'
}

# Scans a visible pane screen on stdin (read with --format ansi; plain text also works), like grep:
# exit status 0 when it FINDS unsent text in the prompt box, 1 when it finds none or cannot tell.
# The prompt box is the region between the LAST TWO rule lines (a line starting with "──"): claude
# draws "❯ <text>" there, pi draws the text on its own line. Text is anything left after the filter
# in _screen_filter and after stripping an optional leading "❯". No box found (fewer than two rules,
# e.g. a menu or a different layout) returns 1, i.e. "can't tell", which never blocks a send.
#
# pi's schedule_prompt extension (the pi-schedule-prompt package's CronWidget) draws its own rule
# bordered box directly below the editor, between it and the footer, whenever any job is loaded for
# the session -- even an already-ended one, since disabled jobs are only swept on the next session
# start. That box's own top/bottom rules would otherwise be mistaken for "the last two rules" here,
# and its fixed header ("Scheduled Prompts (N jobs)") plus job rows would then be misread as a
# permanent, unclearable draft. Recognized by that literal header text -- tied to this package's
# current wording (pi-schedule-prompt's cron-widget.ts); if it's ever renamed, this stops applying
# and the false positive would resurface. When recognized, the search steps back to the immediately
# preceding rule-pair (the editor's own), requiring 4 rule lines total; fewer than that falls
# through to "can't tell" like any other box that can't be found.
scan_screen_for_draft() {
  local line i n first
  local -a lines=() rule_idx=()
  while IFS= read -r line; do lines+=("$line"); done < <(_screen_filter)
  n=${#lines[@]}
  for (( i=0; i<n; i++ )); do
    case "${lines[$i]}" in R*) rule_idx+=("$i") ;; esac
  done
  local m=${#rule_idx[@]} r1 r2
  [ "$m" -ge 2 ] || return 1
  r1=${rule_idx[$((m-2))]}; r2=${rule_idx[$((m-1))]}

  first="${lines[$((r1+1))]#?}"
  first="${first#"${first%%[![:space:]]*}"}"
  if [[ "$first" == "Scheduled Prompts"* ]]; then
    [ "$m" -ge 4 ] || return 1
    r1=${rule_idx[$((m-4))]}; r2=${rule_idx[$((m-3))]}
  fi

  for (( i=r1+1; i<r2; i++ )); do
    line="${lines[$i]#?}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line#❯}"
    line="${line//[[:space:]]/}"
    if [ -n "$line" ]; then return 0; fi
  done
  return 1
}

# Retries internally (up to 5 checks total, 2s apart -- ~8s worst case) rather than making the
# CALLER retry: a caller told to "retry later" observably doesn't reliably do so (a message chain
# can just break off), whereas a bounded internal loop always resolves one way or the other before
# returning. This is an internal implementation detail, not something the calling agent needs to
# know the specifics of or account for -- same as any other command, it just needs a reasonably
# generous declared timeout.
#
# Aborts the whole script (exit 75, "temporary failure"; it does not return) when the TARGET's
# prompt box STILL holds unsent text after all retries are exhausted -- someone is typing there,
# and a delivered message would interleave with their input. Only claude and pi targets are
# checked; target lookup (agent get / kind / pane) happens ONCE, up front -- if it fails, or the
# target isn't claude/pi, or it's the caller's own pane, the send proceeds immediately without
# waiting at all (nothing to retry: we don't yet know anything about a draft). The read asks for
# far more lines than any pane is tall (a tall wrapped draft can put the top rule many lines above
# the bottom one; the visible source never returns more than the pane shows).
#
# Once a draft has been POSITIVELY observed (saw_typing=1), a later attempt that merely fails to
# re-verify (a transient `pane read` error) must NOT be treated as "cleared" -- that would be
# less safe than a single check ever was, since it could deliver into a still-active prompt right
# after confirming someone was mid-draft. Only a successful read that itself shows no draft counts
# as confirmation the box is actually clear; a failed read while saw_typing=1 just consumes a
# retry, same as seeing the draft again, and the loop still gives up (exit 75) if retries run out.
abort_if_target_typing() {
  local target="$1" info kind pane screen attempt saw_typing=0 rc
  # HERDR_MESSAGE_TEST_POLL_SECONDS: private test-only override for the 2s interval, so tests
  # don't have to burn 8 real seconds per case. Not part of the public interface -- never
  # documented or referenced outside this file's own test suite.
  local poll_s="${HERDR_MESSAGE_TEST_POLL_SECONDS:-2}"

  info=$(herdr agent get "$target" 2>/dev/null) || return 0
  kind=$(jq -r '.result.agent.agent // empty' <<<"$info" 2>/dev/null) || return 0
  pane=$(jq -r '.result.agent.pane_id // empty' <<<"$info" 2>/dev/null) || return 0
  case "$kind" in claude|pi) ;; *) return 0 ;; esac
  { [ -n "$pane" ] && [ "$pane" != "${HERDR_PANE_ID:-}" ]; } || return 0

  for attempt in 1 2 3 4 5; do
    # `if screen=$(...)` (not `screen=$(...); rc=$?`) so a failing read doesn't trip `set -e`
    # before rc is even captured.
    if screen=$(herdr pane read "$pane" --source visible --format ansi --lines 500 2>/dev/null); then
      rc=0
    else
      rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
      [ "$saw_typing" = 1 ] || return 0
    elif printf '%s\n' "$screen" | scan_screen_for_draft; then
      saw_typing=1
    else
      return 0
    fi
    [ "$attempt" -lt 5 ] && sleep "$poll_s"
  done
  note "target $target ($pane) still has unsent text in its prompt box after 5 checks -- someone is typing there, so nothing was sent (it would interleave with their input). Retry later: schedule a wake-up (ScheduleWakeup/CronCreate on Claude Code, schedule_prompt on pi) or tell the user. Exit status 75."
  exit 75
}

cmd_send() {
  guard || { note "not in herdr (HERDR_ENV != 1); no-op"; exit 0; }
  [ -n "${HERDR_PANE_ID:-}" ] || die "HERDR_PANE_ID is not set -- cannot determine sender identity"
  # <target> and <text> are fixed-shape REQUIRED positionals, always first, in this order --
  # taken by position, with NO flag-sniffing. The caller here is typically an LLM writing
  # free-form message text, not a careful shell user who knows to prepend "--"; sniffing every
  # token for a leading "-" would misread an ordinary message that happens to start with one
  # (a bullet point, "-1", an em-dash opener, ...) as an unrecognized option.
  [ $# -ge 2 ] || die "usage: herdr-message send <target> <text> [--callback [MSG]]"
  local target="$1" text="$2"; shift 2
  local callback callback_msg
  parse_callback_flags callback callback_msg "$@"
  abort_if_target_typing "$target"
  local id from envelope err
  id=$(generate_message_id)
  from=$(sender_from_line)
  envelope=$(build_send_envelope "$id" "$from" "$text" "$callback" "$callback_msg")
  err=$(herdr agent prompt "$target" "$envelope" 2>&1 >/dev/null) || die "failed to send message to $target${err:+: $err}"
  print_result "$id" "$target"
}

cmd_reply() {
  guard || { note "not in herdr (HERDR_ENV != 1); no-op"; exit 0; }
  [ -n "${HERDR_PANE_ID:-}" ] || die "HERDR_PANE_ID is not set -- cannot determine sender identity"
  # <target> <message-id> <text> are fixed-shape REQUIRED positionals, in this order, taken by
  # position with NO flag-sniffing (same reasoning as send: <text> is free-form and may start with
  # "-"). Any trailing tokens are the optional [--callback [MSG]] flags -- so a threaded reply can
  # ALSO request a further response, exactly like send.
  [ $# -ge 3 ] || die "usage: herdr-message reply <target> <message-id> <text> [--callback [MSG]]"
  local target="$1" id="$2" text="$3"; shift 3
  local callback callback_msg
  parse_callback_flags callback callback_msg "$@"
  abort_if_target_typing "$target"
  local from envelope err
  from=$(sender_from_line)
  envelope=$(build_reply_envelope "$id" "$from" "$text" "$callback" "$callback_msg")
  err=$(herdr agent prompt "$target" "$envelope" 2>&1 >/dev/null) || die "failed to send reply to $target${err:+: $err}"
  print_result "$id" "$target"
}

# A raw, unwrapped delivery of a single bare slash-command (e.g. `/model`, `/clear`, `/compact`)
# to a target's own CLI -- NOT a message. `send`/`reply` always wrap their text in an envelope
# (sender identity, message id, optional callback block), which is correct for conversing with a
# peer agent but would corrupt a slash-command meant to control that peer's interactive session:
# the target would see the literal envelope text, not execute the command. This action exists
# specifically so the herdr-agent-prompt guard can keep one simple invariant (block every direct
# call, no exceptions) while still leaving a narrow, validated escape hatch for CLI control, owned
# here rather than as a carve-out in the guard's own command-position matcher.
#
# Deliberately has NO --callback and accepts no other flags: a raw CLI command has no reply path,
# and allowing one would blur this action's one job. Exactly two positionals, no exceptions --
# unlike send/reply's free-form <text> (which may legitimately start with "-"), this command MUST
# be a single bare slash-command, so requiring $#==2 and then validating its shape both serve the
# same goal and cannot conflict.
cmd_command() {
  guard || { note "not in herdr (HERDR_ENV != 1); no-op"; exit 0; }
  [ $# -eq 2 ] || die "usage: herdr-message command <target> </slash-command> (no flags, e.g. no --callback)"
  local target="$1" command="$2"
  [[ "$command" =~ ^/[^[:space:]]+$ ]] || die "command must be a single bare slash-command (e.g. /model), with no spaces or extra arguments: got '$command'"
  abort_if_target_typing "$target"
  local err
  err=$(herdr agent prompt "$target" "$command" 2>&1 >/dev/null) || die "failed to send command to $target${err:+: $err}"
  jq -nc --arg target "$target" --arg command "$command" '{"sent_to":$target,"command":$command}'
}

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  sub="${1:-}"; shift || true
  case "$sub" in
    send)    cmd_send "$@" ;;
    reply)   cmd_reply "$@" ;;
    command) cmd_command "$@" ;;
    *) die "usage: herdr-message <send|reply|command> ..." ;;
  esac
fi
