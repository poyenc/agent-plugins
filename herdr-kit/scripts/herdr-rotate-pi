#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/rotate-common.sh
source "$HERE/rotate-common.sh"
MODEL_FLAG=--model; EFFORT_FLAG=--thinking; EFFORT_STYLE=flag

validate_override() {   # pi model must be provider-qualified
  local m="$1"
  [ -z "$m" ] && return 0
  case "$m" in */*) return 0 ;; *) die "pi model override must be provider-qualified (e.g. amd-gateway/$m)";; esac
}

exit_fallback() {       # pi ignores single ctrl-c/ctrl-d; two ctrl-d exit
  local pane="$1"
  herdr agent send-keys "$pane" ctrl+d ctrl+d >/dev/null 2>&1 || true
  local deadline=$(( SECONDS + ${ROTATE_EXIT_POLL_SECS:-25} ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    gone "$pane" && return 0
    command sleep 1
  done
  return 1
}

# Reads the LIVE model/effort straight from pi's own /thinking and /model pickers (never
# header/footer/statusline) and cancels both with Esc, leaving nothing changed. Unlike claude,
# pi's agent_status never reports "blocked" for these pickers,
# so closure can't be confirmed via status -- close_modal instead polls for the picker's own
# marker to actually disappear before anything proceeds, so the handoff prompt or the next
# picker is never sent into one that's still open.
#
# A width-independent SNAPSHOT-EQUALITY design (compare the pane's content against a baseline
# captured before opening) was tried first and rejected: confirmed live, in two separate
# end-to-end runs against a real pi agent, that it produces spurious "never closes" failures even
# when the picker plainly is closed and the correct value was already read -- some detail of the
# live render (not fully root-caused; not the footer, which stayed byte-identical across the
# runs that were compared) doesn't reliably return to exact byte-for-byte equality with an
# earlier snapshot even once idle. A hardcoded marker check doesn't have this fragility, since it
# only cares about a few specific characters, not the whole render.
#
# $2 (marker): a SHORT picker marker that stays intact on a SINGLE physical line at a narrow
# (40-column) pane. Confirmed live that a LONG / whole-string marker breaks deterministically:
# pi's renderer truncates a picker footer's tail (a whole-footer match can never succeed there),
# and a marker spanning the selected row's name + bracketed provider can straddle a wrap once the
# name is long enough to push the wrap point mid-marker. The invariant is shortness + single-line
# residency, NOT content-independence: PI_MODEL_SCOPE_MARKER is static picker chrome, whereas
# PI_THINK_MARKER / PI_MODEL_MARKER are value-BEARING yet still safe -- each anchors on the ✓ plus
# the short token riding on the checkmark's own physical line (the effort level, or the model id
# up to the first space), so it survives the wrap instead of straddling it. (Claude's short,
# fixed-length 'Esc to cancel' marker embeds no value at all, so it never had to satisfy this.)
#
# $3 (pending, optional): a regex for the literal command just sent (e.g. "^/model$"), when the
# caller is closing after giving up on that specific command's own open-wait loop. Confirmed
# live: a fresh pi session's first /thinking or /model leaves the raw command text echoed on its
# own line -- with NEITHER marker present -- for several consecutive polls (observed up to and
# beyond 20s in one run) while its catalog loads, before the picker actually renders. That state
# is indistinguishable from "already closed" using marker-absence alone, so any give-up-and-close
# call site passes its own just-sent command here as an extra "still resolving" signal -- a
# closed-form check against a string this exact code just transmitted, not open-ended marker
# enumeration.
#
# Requires TWO CONSECUTIVE clean polls (marker and pending both absent), not one, before
# declaring closed -- a single favorable read isn't sufficient evidence either way.
#
# Escape is resent only while NOT yet clean, never on a round that already was -- confirmed live
# that blindly resending Escape into an already-idle pane (every round, unconditionally, as an
# earlier version of this function did) can trigger an unrelated pi keybinding (reproduced:
# repeated Escapes after a picker had already closed opened pi's own "Session Tree" browser) --
# a new, self-inflicted problem, not progress toward closing anything.
close_modal() {
  local pane="$1" marker="$2" pending="${3:-}" out deadline clean=0
  herdr agent send-keys "$pane" esc >/dev/null 2>&1 || true
  deadline=$(( SECONDS + ${ROTATE_DETECT_POLL_SECS:-30} ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    # A read failure is UNKNOWN, not "closed" -- treating it as closed would let a still-open
    # picker be mistaken for confirmed closure on a transient herdr read error.
    if out=$(herdr pane read "$pane" --source visible --lines 40 2>/dev/null); then
      if printf '%s' "$out" | grep -qE "$marker" || { [ -n "$pending" ] && printf '%s' "$out" | grep -qE "$pending"; }; then
        clean=0
        herdr agent send-keys "$pane" esc >/dev/null 2>&1 || true
      else
        clean=$((clean+1))
        [ "$clean" -ge 2 ] && return 0
      fi
    fi
    command sleep 1
  done
  # note: every call site below propagates this via explicit `|| return 1` -- not relying on
  # this script's own set -e, since some of those call sites run under a caller (verify(), for
  # pi) that disables -e for this whole call chain (see detect_override's own comment).
  note "picker on $pane may not have closed (marker still present); aborting rotation"
  return 1
}

# Selected-row markers for pi's /model and /thinking pickers. The current pi build marks the
# CURRENT live selection with a checkmark (✓, U+2713) immediately BEFORE the value: "→ ✓ <value>".
# This replaced pi's older layout, where the checkmark TRAILED the value/provider
# ("<name> [provider] ✓") -- the marker must now LEAD with ✓. Both are short and lead with the
# ✓+value so they survive narrow-pane wrapping: the value rides on the checkmark's own physical
# line (confirmed live intact down to a 17-column pane for the effort level; to ~34 cols for the
# model NAME -- the model PROVIDER bracket can wrap onto the following physical line at narrow
# widths, recovered in detect_override below).
#
# PI_THINK_MARKER is restricted to the known effort words, so it matches ONLY a /thinking row,
# never a model row that merely starts "✓ <word>". PI_MODEL_MARKER matches "✓ <any non-whitespace
# id token>" -- pi renders the raw item.id, which can START with characters outside a plain
# identifier (e.g. "@cf/..." on cloudflare-workers-ai, "~anthropic/..." on openrouter) and can
# embed "/", so restricting the charset here would make those rows invisible to open-detection.
# It therefore also matches a stale "✓ <level>" -- harmless, since the two pickers are opened and
# closed strictly one at a time and never coexist on screen. detect_override extracts this SAME
# token, so open-detection and extraction never disagree about what the selected id is.
PI_MODEL_SCOPE_MARKER='Scope: all'   # /model picker chrome; kept for the defensive pre-close catch-all
PI_THINK_MARKER='✓[[:space:]]+(off|minimal|low|medium|high|xhigh|max)'
PI_MODEL_MARKER='✓[[:space:]]+[^[:space:]]+'

detect_override() {
  local pane="$1" out="" deadline seen

  DETECTED_MODEL=""
  DETECTED_EFFORT=""

  # Defensive pre-close: catch a stale picker of EITHER kind left open from an earlier call in
  # this same process. Explicit `|| return 1` rather than relying on this script's own set -e: a
  # caller that invokes detect_override as the LHS of || (verify() does, for pi) disables -e for
  # this ENTIRE call chain per POSIX/bash semantics, so a bare failing statement here would
  # silently be ignored instead of aborting.
  close_modal "$pane" "$PI_THINK_MARKER|$PI_MODEL_MARKER|$PI_MODEL_SCOPE_MARKER" || return 1

  # --- effort: LIVE per-session thinking level from /thinking ------------------------------
  # /thinking's picker marks the live in-session level as "→ ✓ <level>" (its own subtitle says
  # "Shift+Tab cycles thinking levels in-session"). This is the SESSION value -- deliberately NOT
  # the /settings "Default thinking level per model" row, which is a GLOBAL default (often "none")
  # that does not track the session (confirmed live: statusline showed the live level while that
  # settings row read "none"). Only open + read + Esc; committing a level needs Enter, never sent.
  herdr agent prompt "$pane" "/thinking" >/dev/null 2>&1 || return 0
  seen=0; deadline=$(( SECONDS + ${ROTATE_DETECT_POLL_SECS:-30} ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    out=$(herdr pane read "$pane" --source visible --lines 20 2>/dev/null || true)
    if printf '%s' "$out" | grep -qE "$PI_THINK_MARKER"; then seen=1; break; fi
    command sleep 1
  done
  if [ "$seen" = 1 ]; then
    # tail -n1: the picker's own current row is the newest match; awk $2 is the level word right
    # after the ✓ ($1). grep -oE trims the trailing description off the row. Short enough to stay
    # intact even at a ~17-column pane (confirmed live).
    DETECTED_EFFORT=$(printf '%s' "$out" | grep -oE "$PI_THINK_MARKER" | tail -n1 | awk '{print $2}') || true
    case "$DETECTED_EFFORT" in off|minimal|low|medium|high|xhigh|max) ;; *) DETECTED_EFFORT="" ;; esac
  fi
  close_modal "$pane" "$PI_THINK_MARKER" '^[[:space:]]*/thinking[[:space:]]*$' || return 1

  # --- model: LIVE model from /model ------------------------------------------------------
  # Open-detection keys off the selected "✓ <name>" row itself (the value row), NOT the top
  # "Scope: all" chrome, so it still fires at a narrow width where that chrome has scrolled out
  # of the visible region but the selection row is still on screen.
  herdr agent prompt "$pane" "/model" >/dev/null 2>&1 || return 0
  out=""; seen=0; deadline=$(( SECONDS + ${ROTATE_DETECT_POLL_SECS:-30} ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    out=$(herdr pane read "$pane" --source visible --lines 30 2>/dev/null || true)
    if printf '%s' "$out" | grep -qE "$PI_MODEL_MARKER"; then seen=1; break; fi
    command sleep 1
  done
  if [ "$seen" = 1 ]; then
    local lineno row name provider next
    # Last matching line (a stale earlier "✓ <name>" in scrollback can't win over the picker's
    # own current selection).
    lineno=$(printf '%s' "$out" | grep -nE "$PI_MODEL_MARKER" | tail -n1 | cut -d: -f1) || lineno=""
    if [ -n "$lineno" ]; then
      row=$(printf '%s' "$out" | sed -n "${lineno}p")
      # Name is the WHOLE non-whitespace id token right after ✓ (checkmark-first layout), via the
      # SAME PI_MODEL_MARKER used for open-detection above -- NOT a restricted charset: pi renders
      # the raw item.id, which can start with "@"/"~" and embed "/" (e.g. "deepseek-ai/DeepSeek-V4-
      # Pro", "@cf/..."). A narrower class would stop at the first such character and silently emit
      # a DIFFERENT, wrong model, so take everything up to the next space instead.
      name=$(printf '%s' "$row" | grep -oE "$PI_MODEL_MARKER" | tail -n1 | awk '{print $2}')
      # Provider bracket: on the ✓ row right after the name (wide), or wrapped onto the NEXT
      # physical line at narrow widths. The next-line form is accepted ONLY when that line STARTS
      # with the bracket -- otherwise it is the NAME that wrapped (its tail, not the provider, is
      # on the next line), so the token grabbed above is a fragment and we must fail empty rather
      # than pair a truncated name with a provider into a corrupted override.
      provider=$(printf '%s' "$row" | grep -oE '\[[A-Za-z0-9._-]+\]' | head -n1 | tr -d '[]')
      if [ -z "$provider" ]; then
        next=$(printf '%s' "$out" | sed -n "$((lineno+1))p")
        if printf '%s' "$next" | grep -qE '^[[:space:]]*\['; then
          provider=$(printf '%s' "$next" | grep -oE '\[[A-Za-z0-9._-]+\]' | head -n1 | tr -d '[]')
        fi
      fi
      # pi model must be provider-qualified; emit only when BOTH halves are present. Any
      # unrecoverable wrap leaves DETECTED_MODEL empty -> safe launch-argv fallback, never a
      # corrupted value.
      [ -n "$name" ] && [ -n "$provider" ] && DETECTED_MODEL="${provider}/${name}"
    fi
  fi
  close_modal "$pane" "$PI_MODEL_MARKER" '^[[:space:]]*/model[[:space:]]*$' || return 1
}

# Guarded so tests can `source` this file to unit-test detect_override/close_modal directly
# (the full finish/verify machinery has enough redundant checks around pi's live detection that
# a stuck-picker regression in one specific branch can otherwise go unobserved end-to-end) --
# identical behavior to before for a normal invocation.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  sub="${1:-}"; shift || true
  case "$sub" in
    handoff) run_handoff pi "$@" ;;
    finish)  run_finish  pi "$@" ;;
    *) die "usage: herdr-rotate-pi <handoff|finish> <name-or-pane> [...]" ;;
  esac
fi
